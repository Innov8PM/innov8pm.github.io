---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  /** Index within the grid, used only to stagger the reveal animation. */
  index?: number
}

const { post, index = 0 } = Astro.props

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<a
  href={`/blog/${post.id}/`}
  class={`reveal reveal-delay-${(index % 3) + 1} group flex flex-col rounded-2xl bg-white border border-gray-100 overflow-hidden hover:border-brand-200/60 transition-all duration-500 hover:shadow-xl hover:shadow-brand-50`}
>
  {
    post.data.cover && (
      <div class="aspect-[16/9] overflow-hidden bg-brand-50">
        <img
          src={post.data.cover}
          alt={post.data.coverAlt ?? post.data.title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="flex flex-col flex-1 p-8">
    <div class="flex items-center gap-3 mb-5 text-xs font-medium uppercase tracking-[0.12em] text-brand-600 font-display">
      <time datetime={post.data.pubDate.toISOString()}>
        {dateFmt.format(post.data.pubDate)}
      </time>
      {
        post.data.tags.length > 0 && (
          <>
            <span class="text-gray-300">&middot;</span>
            <span>{post.data.tags[0]}</span>
          </>
        )
      }
    </div>
    <h2 class="text-xl font-bold text-charcoal mb-3 font-display leading-snug group-hover:text-brand-700 transition-colors duration-300">
      {post.data.title}
    </h2>
    <p class="text-[15px] text-charcoal-light leading-relaxed flex-1">
      {post.data.description}
    </p>
    <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 group-hover:gap-2.5 transition-all duration-300">
      Read more
      <svg aria-hidden="true" focusable="false" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </span>
  </div>
</a>
