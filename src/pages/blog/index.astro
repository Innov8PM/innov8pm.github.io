---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import PostCard from '../../components/PostCard.astro'
import { getBlogPosts } from '../../utils'

const posts = await getBlogPosts()
---

<Layout
  title="Blog — Innov-8"
  description="Insights on panel management, data-driven allocation, and UK field services from the Innov-8 team."
  image="/og/blog.png"
>
  <Nav />

  <main id="main-content" class="pt-40 pb-24 md:pb-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <header class="max-w-2xl mx-auto text-center mb-16 md:mb-20">
        <p class="reveal text-xs font-semibold text-brand-600 uppercase tracking-[0.2em] mb-4 font-display">
          Blog
        </p>
        <h1 class="reveal reveal-delay-1 text-4xl md:text-5xl font-bold tracking-[-0.02em] text-charcoal leading-tight font-display">
          Notes from the panel
        </h1>
        <p class="reveal reveal-delay-2 mt-5 text-lg text-charcoal-light leading-relaxed">
          How we think about allocation, transparency, and performance across UK
          field services.
        </p>
      </header>

      {
        posts.length === 0 ? (
          <p class="text-center text-charcoal-light">No posts yet — check back soon.</p>
        ) : (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {posts.map((post, i) => <PostCard post={post} index={i} />)}
          </div>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>
