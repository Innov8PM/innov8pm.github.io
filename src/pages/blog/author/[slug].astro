---
import Layout from '../../../layouts/Layout.astro'
import Nav from '../../../components/Nav.astro'
import Footer from '../../../components/Footer.astro'
import PostCard from '../../../components/PostCard.astro'
import { getAuthor } from '../../../authors'
import { getBlogPosts } from '../../../utils'

export async function getStaticPaths() {
  const posts = await getBlogPosts()
  const bySlug = new Map<string, typeof posts>()

  for (const post of posts) {
    const slug = post.data.author
    if (!bySlug.has(slug)) bySlug.set(slug, [])
    bySlug.get(slug)!.push(post)
  }

  return [...bySlug.entries()].map(([slug, posts]) => ({
    params: { slug },
    props: {
      author: getAuthor(slug),
      posts: posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }))
}

const { author, posts } = Astro.props
---

<Layout
  title={`${author.name} — Innov-8 Blog`}
  description={author.bio ?? `Posts by ${author.name} on the Innov-8 blog.`}
  image="/og/blog.png"
>
  <Nav />

  <main id="main-content" class="pt-40 pb-24 md:pb-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <header class="max-w-2xl mx-auto text-center mb-16 md:mb-20">
        {
          author.avatar ? (
            <img
              src={author.avatar}
              alt={author.name}
              width="80"
              height="80"
              class="reveal w-20 h-20 rounded-full object-cover ring-2 ring-brand-100 mx-auto mb-5"
            />
          ) : (
            <span class="reveal w-20 h-20 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-2xl font-semibold font-display mx-auto mb-5">
              {author.name.charAt(0)}
            </span>
          )
        }
        <h1 class="reveal reveal-delay-1 text-4xl md:text-5xl font-bold tracking-[-0.02em] text-charcoal leading-tight font-display">
          {author.name}
        </h1>
        {
          author.role && (
            <p class="reveal reveal-delay-2 mt-3 text-sm font-semibold text-brand-600 uppercase tracking-[0.12em] font-display">
              {author.role}
            </p>
          )
        }
        {
          author.bio && (
            <p class="reveal reveal-delay-2 mt-5 text-lg text-charcoal-light leading-relaxed">{author.bio}</p>
          )
        }
        <div class="reveal reveal-delay-3 mt-6 flex items-center justify-center gap-5">
          {
            author.linkedin && (
              <a
                href={author.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${author.name} on LinkedIn`}
                class="text-charcoal-light hover:text-brand-600 transition-colors duration-300"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
            )
          }
          <a
            href="/blog/"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:gap-2.5 transition-all duration-300"
          >
            <svg aria-hidden="true" focusable="false" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            All posts
          </a>
        </div>
      </header>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {posts.map((post, i) => <PostCard post={post} index={i} />)}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
