---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import { getAuthor } from '../../authors'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const author = getAuthor(post.data.author)

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<Layout
  title={`${post.data.title} — Innov-8`}
  description={post.data.description}
  image={`/og/${post.id}.png`}
  type="article"
  publishedDate={post.data.pubDate}
  tags={post.data.tags}
  authorName={author.name}
>
  <Nav />

  <main class="pt-40 pb-24 md:pb-32">
    <article class="max-w-3xl mx-auto px-6 lg:px-8">
      <a
        href="/blog/"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:gap-2.5 transition-all duration-300 mb-10"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        All posts
      </a>

      <header class="mb-10 pb-10 border-b border-gray-100">
        <h1 class="text-3xl md:text-[2.75rem] font-bold tracking-[-0.02em] text-charcoal leading-tight font-display">
          {post.data.title}
        </h1>
        <p class="mt-5 text-lg text-charcoal-light leading-relaxed">
          {post.data.description}
        </p>
        {
          post.data.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-medium">
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <div class="mt-8 flex items-center gap-3.5">
          {
            author.avatar ? (
              <img
                src={author.avatar}
                alt={author.name}
                width="44"
                height="44"
                class="w-11 h-11 rounded-full object-cover ring-2 ring-brand-100"
                loading="lazy"
              />
            ) : (
              <span class="w-11 h-11 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-semibold font-display">
                {author.name.charAt(0)}
              </span>
            )
          }
          <div class="leading-tight">
            <p class="text-sm font-semibold text-charcoal font-display">
              {author.name}
              {author.role && <span class="text-charcoal-light font-normal">&nbsp;&middot; {author.role}</span>}
            </p>
            <time datetime={post.data.pubDate.toISOString()} class="text-sm text-charcoal-light">
              {dateFmt.format(post.data.pubDate)}
            </time>
          </div>
        </div>
      </header>

      <div class="prose-i8">
        <Content />
      </div>

      {
        author.bio && (
          <aside class="mt-14 pt-8 border-t border-gray-100 flex items-start gap-4">
            {author.avatar ? (
              <img
                src={author.avatar}
                alt={author.name}
                width="56"
                height="56"
                class="w-14 h-14 rounded-full object-cover ring-2 ring-brand-100 shrink-0"
                loading="lazy"
              />
            ) : (
              <span class="w-14 h-14 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-semibold font-display shrink-0">
                {author.name.charAt(0)}
              </span>
            )}
            <div>
              <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.12em] font-display">
                Written by
              </p>
              <p class="mt-1 text-base font-bold text-charcoal font-display">
                {author.name}
                {author.role && <span class="text-charcoal-light font-normal">&nbsp;&middot; {author.role}</span>}
              </p>
              <p class="mt-2 text-[15px] text-charcoal-light leading-relaxed">{author.bio}</p>
            </div>
          </aside>
        )
      }

      {
        post.data.updatedDate && (
          <p class="mt-12 text-sm text-charcoal-light italic">
            Updated {dateFmt.format(post.data.updatedDate)}
          </p>
        )
      }
    </article>
  </main>

  <Footer />
</Layout>
