---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import { getAuthor } from '../../authors'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const author = getAuthor(post.data.author)

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<Layout
  title={`${post.data.title} — Innov-8`}
  description={post.data.description}
  image={`/og/${post.id}.png`}
  type="article"
  publishedDate={post.data.pubDate}
  tags={post.data.tags}
  authorName={author.name}
>
  <Nav />

  <main class="pt-40 pb-24 md:pb-32">
    <article class="max-w-3xl mx-auto px-6 lg:px-8">
      <a
        href="/blog/"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:gap-2.5 transition-all duration-300 mb-10"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        All posts
      </a>

      <header class="mb-10 pb-10 border-b border-gray-100">
        <h1 class="text-3xl md:text-[2.75rem] font-bold tracking-[-0.02em] text-charcoal leading-tight font-display">
          {post.data.title}
        </h1>
        <p class="mt-5 text-lg text-charcoal-light leading-relaxed">
          {post.data.description}
        </p>
        {
          post.data.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-medium">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </header>

      <div class="prose-i8">
        <Content />
      </div>

      <aside class="mt-14 pt-8 border-t border-gray-100 flex items-start gap-4">
        {
          author.avatar ? (
            <img
              src={author.avatar}
              alt={author.name}
              width="56"
              height="56"
              class="w-14 h-14 rounded-full object-cover ring-2 ring-brand-100 shrink-0"
              loading="lazy"
            />
          ) : (
            <span class="w-14 h-14 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-semibold font-display shrink-0">
              {author.name.charAt(0)}
            </span>
          )
        }
        <div class="flex-1">
          <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.12em] font-display">
            Written by
          </p>
          <div class="mt-1 flex items-center gap-3 flex-wrap">
            <p class="text-base font-bold text-charcoal font-display">
              {author.name}
              {author.role && <span class="text-charcoal-light font-normal">&nbsp;&middot; {author.role}</span>}
            </p>
            {
              author.linkedin && (
                <a
                  href={author.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${author.name} on LinkedIn`}
                  class="text-charcoal-light hover:text-brand-600 transition-colors duration-300"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                </a>
              )
            }
          </div>
          <time datetime={post.data.pubDate.toISOString()} class="mt-1 block text-sm text-charcoal-light">
            {dateFmt.format(post.data.pubDate)}
          </time>
          {author.bio && <p class="mt-3 text-[15px] text-charcoal-light leading-relaxed">{author.bio}</p>}
        </div>
      </aside>

      {
        post.data.updatedDate && (
          <p class="mt-12 text-sm text-charcoal-light italic">
            Updated {dateFmt.format(post.data.updatedDate)}
          </p>
        )
      }
    </article>
  </main>

  <Footer />
</Layout>
