---
import Layout from '../../../layouts/Layout.astro'
import Nav from '../../../components/Nav.astro'
import Footer from '../../../components/Footer.astro'
import PostCard from '../../../components/PostCard.astro'
import { slugify, getBlogPosts } from '../../../utils'

export async function getStaticPaths() {
  const posts = await getBlogPosts()
  const byTag = new Map<string, { tag: string; posts: typeof posts }>()

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugify(tag)
      if (!byTag.has(slug)) byTag.set(slug, { tag, posts: [] })
      byTag.get(slug)!.posts.push(post)
    }
  }

  return [...byTag.entries()].map(([slug, { tag, posts }]) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }))
}

const { tag, posts } = Astro.props
const label = tag.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
---

<Layout
  title={`${label} — Innov-8 Blog`}
  description={`Articles on ${label.toLowerCase()} from the Innov-8 blog — panel management for UK field services.`}
  image="/og/blog.png"
>
  <Nav />

  <main id="main-content" class="pt-40 pb-24 md:pb-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <header class="max-w-2xl mx-auto text-center mb-16 md:mb-20">
        <p class="reveal text-xs font-semibold text-brand-600 uppercase tracking-[0.2em] mb-4 font-display">
          Tag
        </p>
        <h1 class="reveal reveal-delay-1 text-4xl md:text-5xl font-bold tracking-[-0.02em] text-charcoal leading-tight font-display">
          {label}
        </h1>
        <p class="reveal reveal-delay-2 mt-5 text-lg text-charcoal-light leading-relaxed">
          {posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged &ldquo;{label}&rdquo;.
        </p>
        <a
          href="/blog/"
          class="reveal reveal-delay-3 mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:gap-2.5 transition-all duration-300"
        >
          <svg aria-hidden="true" focusable="false" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          All posts
        </a>
      </header>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {posts.map((post, i) => <PostCard post={post} index={i} />)}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
