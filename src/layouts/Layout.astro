---
import '../styles/global.css'
import { SITE } from '../consts'

interface Props {
  title: string
  description?: string
  /** Path to the social card image, e.g. '/og/home.png'. Defaults to the site card. */
  image?: string
  /** OG type — 'article' for blog posts, otherwise 'website'. */
  type?: 'website' | 'article'
  /** Article metadata (only used when type === 'article'). */
  publishedDate?: Date
  updatedDate?: Date
  tags?: string[]
  authorName?: string
  authorUrl?: string
  /** Clean headline for structured data (the title minus the site suffix). */
  headline?: string
}

const {
  title,
  description = SITE.defaultDescription,
  image = SITE.defaultOgImage,
  type = 'website',
  publishedDate,
  updatedDate,
  tags = [],
  authorName,
  authorUrl,
  headline,
} = Astro.props

// OG requires absolute URLs. Astro.site is set in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(image, Astro.site)

// Structured data (JSON-LD): BlogPosting for articles, Organization otherwise.
const publisher = {
  '@type': 'Organization',
  name: SITE.name,
  url: new URL('/', Astro.site).href,
  logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).href },
}
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: headline ?? title,
        description,
        image: ogImageURL.href,
        ...(publishedDate && { datePublished: publishedDate.toISOString() }),
        dateModified: (updatedDate ?? publishedDate)?.toISOString(),
        author: {
          '@type': 'Person',
          name: authorName,
          ...(authorUrl && { url: new URL(authorUrl, Astro.site).href }),
        },
        publisher,
        mainEntityOfPage: canonicalURL.href,
      }
    : { '@context': 'https://schema.org', ...publisher, description: SITE.defaultDescription }
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {type === 'article' && authorName && <meta name="author" content={authorName} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Innov-8 Blog" href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={title} />
    {
      type === 'article' && publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    {
      type === 'article' && (updatedDate ?? publishedDate) && (
        <meta property="article:modified_time" content={(updatedDate ?? publishedDate)!.toISOString()} />
      )
    }
    {type === 'article' && authorName && <meta property="article:author" content={authorName} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LPEW4X0FXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LPEW4X0FXX');
    </script>
  </head>
  <body class="bg-white text-charcoal font-sans antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />

    <script>
      // Light fade-in for general content (triggers as soon as it edges in).
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('is-visible')
          })
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      )
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el))

      // Route-map figures play their draw/pin animation once, when the figure
      // is properly in view, so the animation is actually seen.
      const figureObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return
            entry.target.classList.add('in-view')
            figureObserver.unobserve(entry.target)
          })
        },
        { threshold: 0.35 }
      )
      document.querySelectorAll('.route-fig').forEach((el) => figureObserver.observe(el))
    </script>
  </body>
</html>
